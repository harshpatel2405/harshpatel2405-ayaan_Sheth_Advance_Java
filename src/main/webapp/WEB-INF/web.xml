<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="https://jakarta.ee 
                             https://jakarta.ee/web-app_6_0.xsd"
         version="6.0">

    <!-- Define the default page when accessing the root URL -->
    <welcome-file-list>
        <welcome-file>HTML/index.html</welcome-file>
    </welcome-file-list>
    
    <!-- one Servlet  welcomeServlet.java-->
    <servlet>
    		<servlet-name>Welcome</servlet-name>
    		<servlet-class>servlet.WelcomeServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
    		<servlet-name>Welcome</servlet-name>
    		<url-pattern>/welcome</url-pattern>
    	</servlet-mapping>
    	
    	<!-- one Servlet  welcomeServlet.java-->
    <servlet>
    		<servlet-name>Login</servlet-name>
    		<servlet-class>servlet.LoginDemoServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
    		<servlet-name>Login</servlet-name>
    		<url-pattern>/login</url-pattern>
    	</servlet-mapping>
    	
    	 <servlet>
    		<servlet-name>Get</servlet-name>
    		<servlet-class>servlet.GetMethod</servlet-class>
    </servlet>
    
    <servlet-mapping>
    		<servlet-name>Get</servlet-name>
    		<url-pattern>/getmethod</url-pattern>
    	</servlet-mapping>
    	
    	 <servlet>
    		<servlet-name>Post</servlet-name>
    		<servlet-class>servlet.PostMethod</servlet-class>
    </servlet>
    
    <servlet-mapping>
    		<servlet-name>Post</servlet-name>
    		<url-pattern>/postmethod</url-pattern>
    	</servlet-mapping>
    	
    <servlet>
    		<servlet-name>NavDemo</servlet-name>
    		<servlet-class>servlet.NavigationDemoPhase4</servlet-class>
    </servlet>
    
    <servlet-mapping>
    	<servlet-name>NavDemo</servlet-name>
    	<url-pattern>/navDemo</url-pattern>
    </servlet-mapping>

</web-app>
